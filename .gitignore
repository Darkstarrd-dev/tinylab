# Binaries
tinylab
tinylab-*
*.exe
*.exe~

# Generated resource file for Windows icon
*.syso

# Config (generated at runtime)
config.yaml
config.yaml.tmp

# State persistence (generated at runtime)
state.yaml

# Free Hub / Web Hub runtime data dirs (created when the app runs with the repo
# root as CWD: {configDir}/jethub or ./jethub). jethub/key is the credential
# encryption key — a local secret that must never enter history.
# ⚠️ Root-anchored on purpose: a bare `jethub/` would also match the tracked
# source tree internal/jethub/ and could silently hide new files there.
/jethub/

# Go workspace
go.work
go.work.sum

# IDE
.vscode/
.idea/

# Logs
server.log
*.log

# OS
.DS_Store
Thumbs.db

# Local reference docs
providerinfo.md
reference/norma-ref/
ref

NUL

# Test artifacts
coverage
coverage.out
tests/**/results.jsonl

# Build output (build.ps1 -All produces 13 variants here)
dist/

# OpenCode working directory
.opencode/

tmp/

# pi-subagents artifact directory
.pi-subagents/

# Runtime lock file (PID for single-instance lock)
.tinylab.lock
.tinyrouter.lock

# Large binary kept locally only (user manual archive)
docs/manuel.rar

# Harness-local agent/skill artifacts (Oh My Pi / Claude skills), not project content
.agents/
.claude/
skills-lock.json

# Qoder IDE workspace state
.qoder/


# Large local model files must not enter project history
Qwen3.6-27B-DSpark.gguf

# Runtime games and game data
/games/
/gamedata/

# Editor V2 build tool dependencies
tools/editor-v2/node_modules/
