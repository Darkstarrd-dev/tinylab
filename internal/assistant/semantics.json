{
  "rules": [
    {"tool": "image.generate", "method": "POST", "path": "/v1/images/generations", "needsModel": true, "keywords": ["生成", "画", "绘图", "出图", "文生图", "做"], "all": ["图"], "none": ["批量", "向量", "embedding", "vector", "编辑", "修"], "desc": "生成图片"},
    {"tool": "image.generate", "method": "POST", "path": "/v1/images/generations", "needsModel": true, "keywords": ["画"], "none": ["表格", "文档", "画线", "画板", "画图", "刻画"], "desc": "画图（无图字意图，如画一只猫）"},
    {"tool": "image.generate", "method": "POST", "path": "/v1/images/generations", "needsModel": true, "keywords": ["generate", "draw", "create"], "all": ["image"], "none": ["batch", "vector", "embedding", "edit", "modify"], "desc": "generate image (EN noun=image)"},
    {"tool": "image.generate", "method": "POST", "path": "/v1/images/generations", "needsModel": true, "keywords": ["generate", "draw", "create"], "all": ["picture"], "none": ["batch", "vector", "embedding", "edit", "modify"], "desc": "generate image (EN noun=picture)"},
    {"tool": "image.edit", "method": "POST", "path": "/v1/images/edits", "needsModel": true, "keywords": ["编辑", "修图", "图片编辑", "编辑图片", "改图"], "desc": "编辑图片"},
    {"tool": "image.edit", "method": "POST", "path": "/v1/images/edits", "needsModel": true, "keywords": ["改"], "all": ["图"], "desc": "编辑图片（改…图，如改一下这张图）"},
    {"tool": "imagebatch.create", "method": "POST", "path": "/api/image-batches", "needsModel": true, "keywords": ["批量"], "desc": "批量生成图片"},
    {"tool": "editor.save", "method": "POST", "path": "/api/editor/save", "keywords": ["写", "文档", "保存", "存档", "save"], "none": ["目录", "打开"], "desc": "保存文档"},
    {"tool": "editor.open", "method": "POST", "path": "/api/editor/open", "keywords": ["打开", "笔记"], "desc": "打开文档"},
    {"tool": "editor.tree", "method": "GET", "path": "/api/editor/tree", "keywords": ["目录", "文档列表", "文件列表"], "desc": "浏览文档树"},
    {"tool": "download.create", "method": "POST", "path": "/api/downloads", "keywords": ["下载", "download"], "none": ["查", "信息", "info"], "desc": "下载视频/音频"},
    {"tool": "download.info", "method": "POST", "path": "/api/downloads/info", "keywords": ["查"], "all": ["视频"], "none": ["下载"], "desc": "查询视频信息"},
    {"tool": "anysearch.search", "method": "POST", "path": "/api/anysearch/search", "keywords": ["搜索", "search", "搜一下"], "desc": "网页搜索"},
    {"tool": "anysearch.extract", "method": "POST", "path": "/api/anysearch/extract", "keywords": ["提取", "正文", "网页"], "desc": "提取网页正文"},
    {"tool": "chat", "method": "POST", "path": "/v1/chat/completions", "needsModel": true, "keywords": ["聊聊", "聊天", "天气", "陪我聊", "对话"], "desc": "聊天对话"},
    {"tool": "embeddings", "method": "POST", "path": "/v1/embeddings", "needsModel": true, "keywords": ["向量", "embedding", "vector"], "desc": "生成向量"},
    {"tool": "archive.pack", "method": "POST", "path": "/api/archive/pack", "keywords": ["打包", "压缩包", "压缩", "归档"], "desc": "打包归档"},
    {"tool": "textreview.session", "method": "POST", "path": "/api/text-review/sessions", "keywords": ["润色", "小说", "文本审", "审校", "校对"], "desc": "文本审润色"},
    {"tool": "trace.clear", "method": "POST", "path": "/api/traces/clear", "keywords": ["清理", "日志", "trace", "清空"], "desc": "清理 trace 日志"},
    {"tool": "models.list", "method": "GET", "path": "/v1/models", "needsModel": true, "keywords": ["模型列表", "列出模型"], "desc": "列出可选模型"},
    {"tool": "providers.list", "method": "GET", "path": "/api/providers", "keywords": ["provider"], "none": ["测试", "test"], "desc": "列出 provider 配置"},
    {"tool": "monitor.view", "method": "GET", "path": "/api/monitor", "keywords": ["监控", "用量"], "none": ["配额", "quota", "清理", "清空"], "desc": "查看用量监控"},
    {"tool": "monitor.quotas", "method": "GET", "path": "/api/monitor/quotas", "keywords": ["配额", "quota"], "desc": "查看模型配额"},
    {"tool": "filetransfer.upload", "method": "POST", "path": "/api/filetransfer/upload", "keywords": ["上传", "upload"], "desc": "上传文件"},
    {"tool": "gallery.convert", "method": "POST", "path": "/api/gallery/tiff", "keywords": ["tiff"], "desc": "Gallery 媒体格式转换"},
    {"tool": "probe.test", "method": "POST", "path": "/api/providers/{id}/models/test-proto", "keywords": ["测试", "test"], "none": ["网络", "网速", "延迟", "ping", "带宽", "bandwidth"], "desc": "测试 provider key/模型"}
  ],
  "jobs": [
    {"name": "clean-traces", "intervalSec": 3600},
    {"name": "clean-traces-daily", "intervalSec": 86400}
  ]
}
